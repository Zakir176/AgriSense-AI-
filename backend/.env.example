# ── Database configuration ───────────────────────────────────────────────────
# For local dev against Docker Compose, POSTGRES_PASSWORD must also be set
# in a root-level .env file so docker-compose can read it.
#
# IMPORTANT: Use "postgresql+psycopg://" — this project uses psycopg[binary] (v3).
# The validator in config.py rewrites "postgres://" and "postgresql://" automatically,
# so Render's internal DB URL can be pasted as-is and will be rewritten correctly.
DATABASE_URL=postgresql+psycopg://postgres:<POSTGRES_PASSWORD>@localhost:5432/agrisense

# ── Auth secret key ──────────────────────────────────────────────────────────
# Generate a secure key with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# REQUIRED — the application will not start without this.
SECRET_KEY=<generate-a-strong-random-key>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ── Seed script credentials ──────────────────────────────────────────────────
# These are ONLY used by seed_data.py. Set them before running the seeder:
#   export SEED_DEMO_PASSWORD=<strong-password>
#   export SEED_OPERATOR_PASSWORD=<strong-password>
# The script will refuse to run if either is unset.
SEED_DEMO_PASSWORD=
SEED_OPERATOR_PASSWORD=

# ── AI/Inference settings ────────────────────────────────────────────────────
UPLOAD_DIR=uploads
DAHUA_CAMERA_RTSP_URL=rtsp://admin:Password123@192.168.1.120:554/cam/realmonitor?channel=1&subtype=1


# ── Production frontend URL ──────────────────────────────────────────────────
# Set this to your deployed frontend origin (e.g. Vercel URL).
# Leave blank for local development.
FRONTEND_URL=https://agri-sense-ai-frontend.vercel.app

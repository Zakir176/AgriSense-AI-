# ── Secrets (F-18): never bake .env files into Docker image layers ───────────
.env
.env.*
!.env.example

# ── Virtual environments (F-21) ──────────────────────────────────────────────
.venv/
venv/
myenv/
myvenv/

# ── Python caches ─────────────────────────────────────────────────────────────
__pycache__/
*.pyc
.pytest_cache/

# ── Local SQLite database (not needed in container) ──────────────────────────
*.db

# ── Uploads (mounted as a Docker volume — don't bake into image) ─────────────
uploads/

# ── IDE / OS ──────────────────────────────────────────────────────────────────
.vscode/
.idea/
.DS_Store

# ── Scratch files ─────────────────────────────────────────────────────────────
scratch/
